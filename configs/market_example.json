{
  "experiment_name": "market_example",
  "description": "Optional SPY example. Data must be downloaded locally first (scripts/download_market_data.py) or supplied by the user; nothing here is bundled.",
  "data": {
    "source": "market",
    "path": "data/market/spy_daily.csv",
    "metadata_path": "data/market/spy_daily_metadata.json"
  },
  "market": {
    "symbol": "SPY",
    "start_date": "2010-01-01",
    "end_date_exclusive": "2025-01-01",
    "price_field": "Adj Close",
    "provider": "yfinance (Yahoo Finance, unofficial interface)"
  },
  "stress_regimes": [
    {"label": "covid_2020", "start_date": "2020-02-20", "end_date": "2020-04-30"},
    {"label": "year_2022", "start_date": "2022-01-01", "end_date": "2022-12-31"}
  ],
  "backtest": {
    "window": 1000,
    "min_residuals": 750,
    "refit_every": 1,
    "confidence_levels": [0.95, 0.99],
    "models": ["HS", "GARCH-FHS", "GJR-FHS"],
    "rolling_exception_window": 250,
    "residual_ljung_box_lags": [10, 20],
    "max_forecasts": null
  },
  "monetary": {
    "notional": 1000000.0
  },
  "output_dir": "results/market_example"
}
